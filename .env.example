# UnterrichtsManager – Umgebungsvariablen

# Node Umgebung
NODE_ENV=production

# Server Port und Host
PORT=3000
HOST=0.0.0.0
# Host-Port auf dem Server (falls Port 3000 belegt ist, z.B. 3005)
# HOST_PORT=3005

# Öffentliche URL hinter dem Caddy Reverse Proxy (wichtig für CSRF-Schutz in SvelteKit)
ORIGIN=https://noten.example.at
PROTOCOL_HEADER=x-forwarded-proto

# Pfad zur SQLite-Datenbankdatei
DATABASE_URL=./data/notenmanager.db

# Initiales Admin-Passwort für den Benutzer 'lehrer' (wird beim ersten Seed gesetzt)
ADMIN_PASSWORD=SicheresPasswortHier123!

# Optional: VAPID Keys für Web Push (werden sonst automatisch in SQLite generiert)
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
